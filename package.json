{
  "name": "dispose-me",
  "version": "7.5.0",
  "description": "Dispose Me is a simple AWS-hosted disposable email service.",
  "author": "Kamil Dybicz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kdybicz/dispose-me.git"
  },
  "engines": {
    "node": ">=v22.0.0",
    "pnpm": ">=10.24.0"
  },
  "bin": {
    "disposeme": "bin/dispose-me.js"
  },
  "scripts": {
    "prebuild": "pnpm install --frozen-lockfile",
    "build:css": "tailwindcss -i ./service/assets/css/styles.css -o ./service/assets/css/output.css --minify",
    "build": "pnpm prebuild && pnpm build:css && rm -Rf dist && webpack",
    "predeploy": "pnpm build && pnpm lint && pnpm test",
    "deploy": "pnpm predeploy && cdk deploy",
    "deploy:ci": "pnpm build:css && webpack && cdk deploy --require-approval never",
    "postdeploy:ci": "cdk gc --unstable=gc --type s3 --created-buffer-days 30 --rollback-buffer-days 0 --confirm false || echo \"Warning: cdk gc failed during postdeploy:ci; please investigate potential S3 GC issues.\" >&2",
    "lint": "biome check ./bin ./lib ./service",
    "lint:ci": "biome lint ./bin ./lib ./service",
    "prestart": "pnpm build:css && LOCAL_DEV_STACK=true cdk synth",
    "start": "pnpm prestart && sam local start-api -t ./cdk.out/DisposeMeStack.template.json",
    "test": "jest --detectOpenHandles",
    "test:coverage": "jest --coverage --detectOpenHandles",
    "test:ci": "jest -ci"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tailwindcss/cli": "^4.3.3",
    "@types/aws-lambda": "^8.10.162",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.1",
    "aws-cdk": "2.1135.0",
    "aws-cdk-lib": "2.263.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.8.1",
    "copy-webpack-plugin": "^14.0.0",
    "dotenv": "^17.4.2",
    "fetch-mock": "^12.6.0",
    "jest": "^30.4.2",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-sources": "^3.5.1",
    "zip-webpack-plugin": "^4.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1103.0",
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/lib-dynamodb": "^3.1103.0",
    "address-rfc2822": "^2.2.4",
    "dayjs": "^1.11.21",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "feed": "^4.2.2",
    "helmet": "^8.3.0",
    "mailparser": "^3.9.14",
    "serverless-http": "^4.0.0",
    "source-map-support": "^0.5.21"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
