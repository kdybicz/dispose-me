{
  "name": "dispose-me",
  "version": "7.5.0",
  "description": "Dispose Me is a simple AWS-hosted disposable email service.",
  "author": "Kamil Dybicz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kdybicz/dispose-me.git"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "yarn": ">=4.18.1"
  },
  "bin": {
    "disposeme": "bin/dispose-me.js"
  },
  "scripts": {
    "audit": "yarn npm audit --recursive --severity high",
    "prebuild": "yarn install --immutable",
    "build:css": "tailwindcss -i ./service/assets/css/styles.css -o ./service/assets/css/output.css --minify",
    "build": "yarn prebuild && yarn build:css && rm -Rf dist && webpack",
    "predeploy": "yarn build && yarn lint && yarn test",
    "deploy": "yarn predeploy && cdk deploy",
    "deploy:ci": "yarn build:css && webpack && cdk deploy --require-approval never",
    "postdeploy:ci": "cdk gc --unstable=gc --type s3 --created-buffer-days 30 --rollback-buffer-days 0 --confirm false || echo \"Warning: cdk gc failed during postdeploy:ci; please investigate potential S3 GC issues.\" >&2",
    "lint": "biome check ./bin ./lib ./service",
    "lint:ci": "biome lint ./bin ./lib ./service",
    "prestart": "yarn build:css && LOCAL_DEV_STACK=true cdk synth",
    "start": "yarn prestart && sam local start-api -t ./cdk.out/DisposeMeStack.template.json",
    "test": "jest --detectOpenHandles",
    "test:coverage": "jest --coverage --detectOpenHandles",
    "test:ci": "jest --ci"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/cli": "^4.3.3",
    "@types/aws-lambda": "^8.10.164",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.1",
    "aws-cdk": "2.1144.0",
    "aws-cdk-lib": "2.272.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.8.1",
    "copy-webpack-plugin": "^14.0.0",
    "dotenv": "^18.0.5",
    "fetch-mock": "^12.6.0",
    "glob": "^13.0.6",
    "jest": "^30.5.2",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-sources": "^3.6.0",
    "zip-webpack-plugin": "^4.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "address-rfc2822": "^2.2.4",
    "dayjs": "^1.11.23",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "feed": "^4.2.2",
    "helmet": "^8.3.0",
    "mailparser": "^3.9.34",
    "serverless-http": "^4.0.0",
    "source-map-support": "^0.5.21"
  },
  "packageManager": "yarn@4.18.1"
}
